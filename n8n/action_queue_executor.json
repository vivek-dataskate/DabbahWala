      "id": "fetch-pending-actions",
      "name": "Fetch Pending Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-actions",
              "leftValue": "={{ Array.isArray($json) ? $json.length : (Array.isArray($input.all()[0]?.json) ? $input.all()[0].json.length : $input.all().length) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-actions",
      "name": "Has Pending Actions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// n8n HTTP Request already splits the JSON array into individual items.\n// Each item arriving here is one action object — just pass them through.\nreturn $input.all().map(item => ({ json: item.json }));"
      },
      "id": "split-actions",
      "name": "Split Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
