      "id": "build-escalation-body",
      "name": "Build Escalation Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        220
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.payload || {};\nconst body = JSON.stringify({\n  records: [{\n    fields: {\n      'Customer Name': ((item.first_name || '') + ' ' + (item.last_name || '')).trim() || 'Unknown',\n      'Phone': item.phone || '',\n      'Email': item.email || '',\n      'Priority': payload.urgency === 'high' ? 'Hot' : 'Warm',\n      'Reason': (payload.notes || 'Escalated by Orchestrator').substring(0, 2000),\n      'Suggested Action': (payload.suggested_copy || '').substring(0, 500),\n      'Status': 'New',\n      'Action Type': 'field_sales_call',\n      'Confidence Score': 0.9\n    }\n  }]\n});\nreturn [{ json: { ...item, _body: body } }];"
      }
    },
    {
      "id": "build-field-sales-body",
      "name": "Build Field Sales Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        440
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.payload || {};\nconst body = JSON.stringify({\n  records: [{\n    fields: {\n      'Customer Name': payload.customer_name || '',\n      'Phone': payload.phone || '',\n      'Email': payload.email || '',\n      'Priority': payload.priority || 'Warm',\n      'Reason': (payload.reason || '').substring(0, 2000),\n      'Suggested Action': (payload.suggested_action || '').substring(0, 500),\n      'Action Type': payload.action_type || '',\n      'Lifecycle Stage': payload.lifecycle_stage || '',\n      'Total Orders': payload.total_orders || 0,\n      'Last Order': payload.last_order || '',\n      'Postgres Opportunity ID': payload.postgres_opportunity_id || '',\n      'Status': 'New'\n    }\n  }]\n});\nreturn [{ json: { ...item, _body: body } }];"
      }
    }
