{
  "name": "DabbahWala — Action Queue Executor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{https://dabbahwala-latest.onrender.com}}/api/agents/action-queue/pending",
        "options": {}
      },
      "id": "fetch-pending-actions",
      "name": "Fetch Pending Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-actions",
              "leftValue": "={{ Array.isArray($json) ? $json.length : 0 }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-actions",
      "name": "Has Pending Actions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "=",
        "options": {}
      },
      "id": "split-actions",
      "name": "Split Actions",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [880, 240]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action_type }}",
                    "rightValue": "send_sms",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "send_sms"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action_type }}",
                    "rightValue": "move_campaign",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "move_campaign"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action_type }}",
                    "rightValue": "escalate_airtable",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "escalate_airtable"
            }
          ]
        },
        "options": {}
      },
      "id": "route-by-type",
      "name": "Route by Action Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1100, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telnyx.com/v2/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{$env.TELNYX_FROM_NUMBER}}\",\n  \"to\": \"{{ $json.phone }}\",\n  \"text\": \"{{ $json.payload.message_body || 'DabbahWala: We have something special for you today!' }}\"\n}",
        "options": {}
      },
      "id": "execute-sms",
      "name": "Send SMS via Telnyx",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TELNYX_CREDENTIAL_ID",
          "name": "Telnyx API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{https://dabbahwala-latest.onrender.com}}/api/telnyx/message",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_email\": \"{{ $('Split Actions').item.json.email }}\",\n  \"direction\": \"outbound\",\n  \"from_number\": \"{{$env.TELNYX_FROM_NUMBER}}\",\n  \"to_number\": \"{{ $('Split Actions').item.json.phone }}\",\n  \"body\": \"{{ $('Split Actions').item.json.payload.message_body || '' }}\",\n  \"telnyx_msg_id\": \"{{ $json.data?.id || '' }}\",\n  \"status\": \"sent\",\n  \"is_delivery_staff\": false,\n  \"metadata\": { \"source\": \"action_queue\", \"action_id\": {{ $('Split Actions').item.json.id }} }\n}",
        "options": {}
      },
      "id": "store-sent-sms",
      "name": "Store Sent SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{https://dabbahwala-latest.onrender.com}}/api/agents/action-queue/{{ $('Split Actions').item.json.id }}/done",
        "options": {}
      },
      "id": "mark-sms-done",
      "name": "Mark SMS Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/{{$env.AIRTABLE_BASE_ID}}/{{$env.AIRTABLE_FIELD_SALES_TABLE}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"Customer Name\": \"{{ $json.first_name || '' }} {{ $json.last_name || '' }}\",\n    \"Phone\": \"{{ $json.phone || '' }}\",\n    \"Email\": \"{{ $json.email || '' }}\",\n    \"Priority\": \"{{ ($json.payload.urgency || 'medium') === 'high' ? 'Hot' : 'Warm' }}\",\n    \"Reason\": \"{{ $json.payload.notes || 'Escalated by Orchestrator Agent' }}\",\n    \"Suggested Action\": \"{{ $json.payload.suggested_copy || '' }}\",\n    \"Status\": \"New\",\n    \"Action Type\": \"field_sales_call\",\n    \"Confidence Score\": 0.9\n  }\n}",
        "options": {}
      },
      "id": "create-airtable-escalation",
      "name": "Create Airtable Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 320],
      "credentials": {
        "httpHeaderAuth": {
          "id": "AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{https://dabbahwala-latest.onrender.com}}/api/agents/action-queue/{{ $('Split Actions').item.json.id }}/done",
        "options": {}
      },
      "id": "mark-escalation-done",
      "name": "Mark Escalation Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.instantly.ai/api/v2/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "campaign_id", "value": "={{ $json.payload.instantly_campaign_id || '' }}" },
            { "name": "email", "value": "={{ $json.email }}" },
            { "name": "phone", "value": "={{ $json.phone }}" },
            { "name": "skip_if_in_workspace", "value": "=false" }
          ]
        },
        "options": {}
      },
      "id": "move-campaign",
      "name": "Move to Campaign (Instantly)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 520],
      "credentials": {
        "httpHeaderAuth": {
          "id": "instantly-api-key",
          "name": "Instantly API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{https://dabbahwala-latest.onrender.com}}/api/agents/action-queue/{{ $('Split Actions').item.json.id }}/done",
        "options": {}
      },
      "id": "mark-campaign-done",
      "name": "Mark Campaign Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 520]
    },
    {
      "parameters": {},
      "id": "no-actions",
      "name": "No Actions — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 400]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Fetch Pending Actions", "type": "main", "index": 0 }]]
    },
    "Fetch Pending Actions": {
      "main": [[{ "node": "Has Pending Actions?", "type": "main", "index": 0 }]]
    },
    "Has Pending Actions?": {
      "main": [
        [{ "node": "Split Actions", "type": "main", "index": 0 }],
        [{ "node": "No Actions — Skip", "type": "main", "index": 0 }]
      ]
    },
    "Split Actions": {
      "main": [[{ "node": "Route by Action Type", "type": "main", "index": 0 }]]
    },
    "Route by Action Type": {
      "send_sms":          [{ "node": "Send SMS via Telnyx", "type": "main", "index": 0 }],
      "escalate_airtable": [{ "node": "Create Airtable Escalation", "type": "main", "index": 0 }],
      "move_campaign":     [{ "node": "Move to Campaign (Instantly)", "type": "main", "index": 0 }]
    },
    "Send SMS via Telnyx": {
      "main": [[{ "node": "Store Sent SMS", "type": "main", "index": 0 }]]
    },
    "Store Sent SMS": {
      "main": [[{ "node": "Mark SMS Done", "type": "main", "index": 0 }]]
    },
    "Create Airtable Escalation": {
      "main": [[{ "node": "Mark Escalation Done", "type": "main", "index": 0 }]]
    },
    "Move to Campaign (Instantly)": {
      "main": [[{ "node": "Mark Campaign Done", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [
    { "name": "DabbahWala", "id": "dabbahwala" },
    { "name": "Agent Intelligence", "id": "agents" }
  ],
  "pinData": {}
}
