{
  "name": "DabbahWala — Weekly Lapsed Customer Cycle",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 1 * * 0"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Sunday 1am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/agents/cycle/run-all-lapsed",
        "options": {
          "timeout": 600000
        }
      },
      "id": "run-lapsed-cycle",
      "name": "Run Lapsed Customer Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Log and summarise the weekly lapsed run\nconst result = $input.item.json;\nconst processed = result.processed || 0;\nconst errors = (result.errors || []).length;\nconst results = result.results || [];\n\nconst actions = {};\nfor (const r of results) {\n  const action = r.chosen_action || 'none';\n  actions[action] = (actions[action] || 0) + 1;\n}\n\nconsole.log(\n  `Lapsed cycle: processed=${processed} errors=${errors} actions=${JSON.stringify(actions)}`\n);\n\nreturn [{ json: {\n  ...result,\n  action_summary: actions,\n  has_actions: processed > 0 && (actions['send_sms'] || 0) + (actions['move_campaign'] || 0) + (actions['escalate_airtable'] || 0) > 0\n}}];"
      },
      "id": "log-results",
      "name": "Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-actions",
              "leftValue": "={{ $json.has_actions }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-actions-check",
      "name": "Any Actions Taken?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://hooks.slack.com/services/placeholder",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"Weekly lapsed customer cycle complete!\\n- Processed: {{ $json.processed }}\\n- Actions: {{ JSON.stringify($json.action_summary) }}\\n- Errors: {{ ($json.errors || []).length }}\"\n}",
        "options": {}
      },
      "id": "notify-slack",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 200]
    },
    {
      "parameters": {},
      "id": "no-actions",
      "name": "No Actions — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, 420]
    }
  ],
  "connections": {
    "Every Sunday 1am": {
      "main": [
        [
          {
            "node": "Run Lapsed Customer Cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Lapsed Customer Cycle": {
      "main": [
        [
          {
            "node": "Log Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Results": {
      "main": [
        [
          {
            "node": "Any Actions Taken?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Actions Taken?": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Actions — Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "DabbahWala",
      "id": "dabbahwala"
    },
    {
      "name": "Lapsed Customers",
      "id": "lapsed"
    }
  ],
  "pinData": {}
}
