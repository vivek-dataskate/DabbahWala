{
  "name": "DabbahWala — Opportunity Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.DABBAHWALA_API_URL}}/api/opportunities/pending",
        "options": {}
      },
      "id": "fetch-pending",
      "name": "Fetch Pending Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-has-items",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-opportunities",
      "name": "Has Opportunities?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "=",
        "options": {}
      },
      "id": "split-items",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [880, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/{{$env.AIRTABLE_BASE_ID}}/{{$env.AIRTABLE_FIELD_SALES_TABLE}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"Customer Name\": \"{{ $json.first_name || '' }} {{ $json.last_name || '' }}\",\n    \"Phone\": \"{{ $json.phone || '' }}\",\n    \"Email\": \"{{ $json.email || '' }}\",\n    \"Priority\": \"{{ ($json.priority || 'warm').charAt(0).toUpperCase() + ($json.priority || 'warm').slice(1) }}\",\n    \"Reason\": \"{{ $json.reason || '' }}\",\n    \"Suggested Action\": \"{{ $json.suggested_message || '' }}\",\n    \"Lifecycle Stage\": \"{{ $json.lifecycle_segment || '' }}\",\n    \"Total Orders\": {{ $json.total_orders || 0 }},\n    \"Postgres Opportunity ID\": {{ $json.id }},\n    \"Status\": \"New\",\n    \"Action Type\": \"{{ $json.action || '' }}\",\n    \"Confidence Score\": {{ $json.confidence_score || 0 }}\n  }\n}",
        "options": {}
      },
      "id": "create-airtable-record",
      "name": "Create Airtable Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DABBAHWALA_API_URL}}/api/opportunities/{{ $('Split Into Items').item.json.id }}/dispatched",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"airtable_record_id\": \"{{ $json.id }}\"\n}",
        "options": {}
      },
      "id": "mark-dispatched",
      "name": "Mark Dispatched in Postgres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 240]
    },
    {
      "parameters": {},
      "id": "no-opportunities",
      "name": "No Pending — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 400]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Pending Opportunities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Opportunities": {
      "main": [
        [
          {
            "node": "Has Opportunities?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Opportunities?": {
      "main": [
        [
          {
            "node": "Split Into Items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Pending — Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Into Items": {
      "main": [
        [
          {
            "node": "Create Airtable Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Airtable Record": {
      "main": [
        [
          {
            "node": "Mark Dispatched in Postgres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "DabbahWala",
      "id": "dabbahwala"
    },
    {
      "name": "Step 3 — Opportunities",
      "id": "step3"
    }
  ],
  "pinData": {}
}
