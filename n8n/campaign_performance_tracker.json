      "id": "fetch-campaign-list",
      "name": "Get DabbahWala Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract the campaigns array and return one item per campaign\nconst data = $input.first().json;\nconst campaigns = data.campaigns || [];\nreturn campaigns\n  .filter(c => c.campaign_id)\n  .map(c => ({ json: { campaign_id: c.campaign_id, campaign_name: c.campaign_name || '' } }));"
      },
      "id": "split-campaigns",
      "name": "Split Into One Per Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.instantly.ai/api/v2/campaigns/analytics",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer OThjYmE4NjQtMjMwYS00ZGM2LWIzMTgtNWY2YzYxZTZmNDEyOmVwbU1CSFRWa3ZiaQ=="
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $json.campaign_id }}"
            },
            {
              "name": "exclude_total_leads_count",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "fetch-analytics",
      "name": "Fetch Campaign Analytics from Instantly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normalise Instantly analytics response → shape Render expects\n// /api/v2/campaigns/analytics returns an array; unwrap it\nconst raw = $input.first().json;\nconst a = Array.isArray(raw) ? (raw[0] || {}) : raw;\n\n// If no data returned for this campaign, skip gracefully\nif (!a.campaign_id && !a.emails_sent_count) {\n  return [{ json: {\n    campaign_id: $('Split Into One Per Campaign').first().json.campaign_id,\n    skipped: true\n  }}];\n}\n\nconst emailsSent   = a.emails_sent_count ?? null;\nconst opens        = a.open_count        ?? null;\nconst uniqueOpens  = a.open_count_unique ?? opens;\nconst replies      = a.reply_count       ?? null;\nconst clicks       = a.link_click_count  ?? null;\nconst bounces      = a.bounced_count     ?? null;\nconst unsubscribes = a.unsubscribed_count ?? null;\nconst leadsCount   = a.leads_count       ?? null;\n\n// Compute rates (avoid division by zero)\nconst openRate  = (emailsSent && opens  != null) ? Math.round(opens  / emailsSent * 10000) / 100 : null;\nconst replyRate = (emailsSent && replies != null) ? Math.round(replies / emailsSent * 10000) / 100 : null;\n\nreturn [{\n  json: {\n    campaign_id:  a.campaign_id || $('Split Into One Per Campaign').first().json.campaign_id,\n    leads_count:  leadsCount,\n    emails_sent:  emailsSent,\n    unique_opens: uniqueOpens,\n    opens,\n    replies,\n    clicks,\n    bounces,\n    unsubscribes,\n    open_rate:    openRate,\n    reply_rate:   replyRate\n  }\n}];"
      },
      "id": "normalise-stats",
      "name": "Normalise Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/webhooks/campaign-stats",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "save-stats",
      "name": "Save Stats to Render DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
