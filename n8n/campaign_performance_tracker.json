{
  "name": "[Email Campaigns] Performance Tracker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://dabbahwala-latest.onrender.com/api/webhooks/campaigns",
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-campaign-list",
      "name": "Get DabbahWala Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract the campaigns array and return one item per campaign\nconst data = $input.first().json;\nconst campaigns = data.campaigns || [];\nreturn campaigns\n  .filter(c => c.campaign_id)\n  .map(c => ({ json: { campaign_id: c.campaign_id, campaign_name: c.campaign_name || '' } }));"
      },
      "id": "split-campaigns",
      "name": "Split Into One Per Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.instantly.ai/api/v2/campaigns/analytics",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer OThjYmE4NjQtMjMwYS00ZGM2LWIzMTgtNWY2YzYxZTZmNDEyOmVwbU1CSFRWa3ZiaQ=="
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $json.campaign_id }}"
            },
            {
              "name": "exclude_total_leads_count",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "fetch-analytics",
      "name": "Fetch Campaign Analytics from Instantly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normalise Instantly analytics response → shape Render expects\n// /api/v2/campaigns/analytics returns an array; unwrap it.\n// When the API returns [] (no data for this campaign), alwaysOutputData passes\n// through the split-node input {campaign_id, campaign_name} — detect by absence\n// of emails_sent_count and return zero-value stats so save-stats always runs.\nconst raw = $input.first().json;\nconst a = Array.isArray(raw) ? (raw[0] || {}) : raw;\n\nconst campaignId = a.campaign_id || $('Split Into One Per Campaign').first().json.campaign_id;\n\n// No analytics data — campaign not yet launched or has no sends\nif (typeof a.emails_sent_count === 'undefined') {\n  return [{ json: {\n    campaign_id:  campaignId,\n    leads_count:  0,\n    emails_sent:  0,\n    unique_opens: 0,\n    opens:        0,\n    replies:      0,\n    clicks:       0,\n    bounces:      0,\n    unsubscribes: 0,\n    open_rate:    0,\n    reply_rate:   0\n  }}];\n}\n\nconst emailsSent   = a.emails_sent_count  ?? 0;\nconst opens        = a.open_count         ?? 0;\nconst uniqueOpens  = a.open_count_unique  ?? opens;\nconst replies      = a.reply_count        ?? 0;\nconst clicks       = a.link_click_count   ?? 0;\nconst bounces      = a.bounced_count      ?? 0;\nconst unsubscribes = a.unsubscribed_count ?? 0;\nconst leadsCount   = a.leads_count        ?? 0;\n\nconst openRate  = emailsSent > 0 ? Math.round(opens   / emailsSent * 10000) / 100 : 0;\nconst replyRate = emailsSent > 0 ? Math.round(replies / emailsSent * 10000) / 100 : 0;\n\nreturn [{\n  json: {\n    campaign_id:  campaignId,\n    leads_count:  leadsCount,\n    emails_sent:  emailsSent,\n    unique_opens: uniqueOpens,\n    opens,\n    replies,\n    clicks,\n    bounces,\n    unsubscribes,\n    open_rate:    openRate,\n    reply_rate:   replyRate\n  }\n}];"
      },
      "id": "normalise-stats",
      "name": "Normalise Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/webhooks/campaign-stats",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "save-stats",
      "name": "Save Stats to Render DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {},
      "id": "done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1540,
        300
      ]
    },
    {
      "id": "4bd008a4-a84d-4fe8-b3f8-d7b322ec7b0d",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        460
      ],
      "parameters": {}
    }
  ],
