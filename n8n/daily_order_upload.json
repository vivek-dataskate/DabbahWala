{
  "name": "DabbahWala - Daily Order Upload",
  "nodes": [
    {
      "id": "trigger",
      "name": "Daily at 1PM (after orders processed)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [100, 300],
      "parameters": {
        "rule": {
          "interval": [{"field": "cronExpression", "expression": "0 13 * * *"}]
        }
      },
      "notes": "Runs daily at 1PM EST after morning orders are processed"
    },
    {
      "id": "manual_trigger",
      "name": "Manual Upload",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [100, 450],
      "notes": "Manual trigger for ad-hoc uploads"
    },
    {
      "id": "read_file",
      "name": "Read Processing Data CSV",
      "type": "n8n-nodes-base.readBinaryFiles",
      "position": [300, 300],
      "parameters": {
        "fileSelector": "={{$env.ORDER_DATA_PATH || '/data/processing-data-' + $now.format('yyyy-MM-dd') + '.csv'}}"
      },
      "notes": "Read today's processing-data-YYYY-MM-DD.csv file"
    },
    {
      "id": "upload_to_api",
      "name": "Upload to DabbahWala API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [500, 300],
      "parameters": {
        "method": "POST",
        "url": "{{$env.DABBAHWALA_API_URL}}/api/daily-orders/process",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {"name": "file", "parameterType": "formBinaryData", "inputDataFieldName": "data"}
          ]
        },
        "options": {"timeout": 300000}
      },
      "notes": "POST CSV to /api/daily-orders/process endpoint"
    },
    {
      "id": "check_result",
      "name": "Check Processing Result",
      "type": "n8n-nodes-base.if",
      "position": [700, 300],
      "parameters": {
        "conditions": {
          "number": [{"value1": "={{$json.total_orders}}", "operation": "larger", "value2": 0}]
        }
      }
    },
    {
      "id": "run_intelligence",
      "name": "Run Intelligence Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "position": [900, 250],
      "parameters": {
        "method": "POST",
        "url": "{{$env.DABBAHWALA_API_URL}}/api/intelligence/run-cycle",
        "options": {"timeout": 120000}
      },
      "notes": "Run full intelligence cycle after order data is loaded"
    },
    {
      "id": "notify_success",
      "name": "Notify: Orders Processed",
      "type": "n8n-nodes-base.slack",
      "position": [1100, 250],
      "parameters": {
        "channel": "={{$env.SLACK_CHANNEL || '#dabbahwala-ops'}}",
        "text": "Daily orders processed!\n- Date: {{$json.date}}\n- Orders: {{$json.total_orders}}\n- Revenue: ${{$json.total_revenue}}\n- New customers: {{$json.new_contacts}}\n- Opportunities: {{$json.opportunities_created}}"
      },
      "notes": "Send summary to Slack"
    },
    {
      "id": "notify_failure",
      "name": "Notify: No Orders or Error",
      "type": "n8n-nodes-base.slack",
      "position": [900, 400],
      "parameters": {
        "channel": "={{$env.SLACK_CHANNEL || '#dabbahwala-ops'}}",
        "text": "Daily order upload had issues. Check logs."
      }
    }
  ],
  "connections": {
    "trigger": {"main": [[{"node": "read_file"}]]},
    "manual_trigger": {"main": [[{"node": "read_file"}]]},
    "read_file": {"main": [[{"node": "upload_to_api"}]]},
    "upload_to_api": {"main": [[{"node": "check_result"}]]},
    "check_result": {"main": [[{"node": "run_intelligence"}], [{"node": "notify_failure"}]]},
    "run_intelligence": {"main": [[{"node": "notify_success"}]]}
  },
  "env_variables_needed": [
    "DABBAHWALA_API_URL",
    "ORDER_DATA_PATH",
    "SLACK_CHANNEL"
  ]
}
