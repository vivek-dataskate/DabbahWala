{
  "name": "DabbahWala \u2014 Daily Order Upload",
  "nodes": [
    {
      "id": "n1",
      "name": "Daily at 1PM EST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        160,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 1-6"
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Manual Upload",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        160,
        460
      ],
      "parameters": {}
    },
    {
      "id": "n3",
      "name": "Upload Orders to API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/daily-orders/process",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ orders: $input.all().map(i => i.json) }) }}"
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "n4",
      "name": "Has Orders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        380
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ingested }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n5",
      "name": "Run Agent Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        880,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/agents/cycle/run-all",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "n6",
      "name": "No Orders \u2014 Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        480
      ],
      "parameters": {}
    },
    {
      "id": "n7",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1120,
        280
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Daily at 1PM EST": {
      "main": [
        [
          {
            "node": "Upload Orders to API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Upload": {
      "main": [
        [
          {
            "node": "Upload Orders to API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Orders to API": {
      "main": [
        [
          {
            "node": "Has Orders?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Orders?": {
      "main": [
        [
          {
            "node": "Run Agent Cycle",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Orders \u2014 Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Agent Cycle": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "staticData": null,
  "tags": [],
  "pinData": null
}