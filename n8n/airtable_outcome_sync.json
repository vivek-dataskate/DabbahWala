{
  "name": "[Field Agent] Outcome Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "id": "fetch-updated-airtable",
      "name": "Fetch Updated Airtable Records",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/{{ $('Get Credentials').first().json.AIRTABLE_BASE_ID }}/Field%20Sales%20Tasks",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Credentials').first().json.AIRTABLE_API_KEY }}"
            }
          ]
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "AND({Status} != 'New', {Status} != '', {Synced to Postgres} != TRUE())"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "parameters": {
        "jsCode": "// Map Airtable status to API status + outcome\nconst airtableStatus = $input.item.json.fields['Status'];\nconst opportunityId = $input.item.json.fields['Postgres Opportunity ID'];\nconst outcomeNotes = $input.item.json.fields['Outcome Notes'] || '';\nconst airtableRecordId = $input.item.json.id;\n\nlet apiStatus = 'completed';\nlet outcome = null;\n\nswitch (airtableStatus?.toLowerCase()) {\n  case 'ordered':\n  case 'converted':\n    apiStatus = 'completed';\n    outcome = 'ordered';\n    break;\n  case 'not interested':\n  case 'not_interested':\n  case 'declined':\n    apiStatus = 'completed';\n    outcome = 'not_interested';\n    break;\n  case 'no answer':\n  case 'no_answer':\n  case 'unreachable':\n    apiStatus = 'completed';\n    outcome = 'no_answer';\n    break;\n  case 'in progress':\n  case 'in_progress':\n  case 'contacted':\n    apiStatus = 'dispatched';\n    outcome = null;\n    break;\n  default:\n    apiStatus = 'completed';\n    outcome = airtableStatus?.toLowerCase() || 'no_answer';\n}\n\nreturn {\n  json: {\n    opportunity_id: opportunityId,\n    airtable_record_id: airtableRecordId,\n    api_status: apiStatus,\n    outcome: outcome,\n    outcome_notes: outcomeNotes\n  }\n};"
      },
      "id": "map-status",
      "name": "Map Airtable Status \u2192 API Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-outcome",
              "leftValue": "={{ $json.outcome }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-outcome",
      "name": "Has Final Outcome?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/opportunities/{{ $json.opportunity_id }}/outcome",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"{{ $json.api_status }}\",\n  \"outcome\": \"{{ $json.outcome }}\",\n  \"outcome_notes\": \"{{ $json.outcome_notes }}\"\n}",
        "options": {}
      },
      "id": "post-outcome",
      "name": "Post Outcome to Postgres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        240
      ]
    },
    {
      "id": "mark-synced",
      "name": "Mark Synced in Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        240
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/{{ $('Get Credentials').first().json.AIRTABLE_BASE_ID }}/Field%20Sales%20Tasks/{{ $json.airtable_record_id }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Credentials').first().json.AIRTABLE_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"fields\": {\"Synced to Postgres\": true}}",
        "options": {}
      }
    },
    {
      "parameters": {},
      "id": "skip-in-progress",
      "name": "In Progress \u2014 Skip Sync",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        380
      ]
    },
    {
      "id": "8ee10d2e-ee16-4e28-8a93-9c831348ffe5",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        460
      ],
      "parameters": {}
    },
    {
      "id": "get-credentials",
      "name": "Get Credentials",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        350,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://dabbahwala-latest.onrender.com/api/credentials",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "dw-admin-secret",
          "name": "DW Admin Secret"
        }
      }
    },
    {
      "id": "flatten-records",
      "name": "Flatten Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nreturn (data.records || []).map(r => ({\n  json: { airtable_record_id: r.id, ...r.fields }\n}));"
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Get Credentials",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Updated Airtable Records": {
      "main": [
        [
          {
            "node": "Flatten Records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map Airtable Status \u2192 API Status": {
      "main": [
        [
          {
            "node": "Has Final Outcome?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Final Outcome?": {
      "main": [
        [
          {
            "node": "Post Outcome to Postgres",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "In Progress \u2014 Skip Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post Outcome to Postgres": {
      "main": [
        [
          {
            "node": "Mark Synced in Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get Credentials",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Credentials": {
      "main": [
        [
          {
            "node": "Fetch Updated Airtable Records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flatten Records": {
      "main": [
        [
          {
            "node": "Map Airtable Status \u2192 API Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
