{
  "name": "DabbahWala \u2014 Marketing Query Form",
  "nodes": [
    {
      "id": "m1",
      "name": "Marketing Query Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        160,
        360
      ],
      "parameters": {
        "formTitle": "DabbahWala Marketing Query",
        "formDescription": "Submit a query or team input. Contact info required to route to the agent pipeline.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": false
            },
            {
              "fieldLabel": "Phone",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Category",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "General Query"
                  },
                  {
                    "option": "Reorder Nudge"
                  },
                  {
                    "option": "Complaint"
                  },
                  {
                    "option": "Team Note"
                  },
                  {
                    "option": "Marketing Input"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Query / Note",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "m2",
      "name": "Map Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        360
      ],
      "parameters": {
        "jsCode": "\nconst row = $input.first().json;\nconst cat = (row['Category'] || 'general').toLowerCase().replace(/[^a-z]/g,'_');\nreturn [{json:{\n  name: row['Name'] || '',\n  email: row['Email'] || '',\n  phone: row['Phone'] || '',\n  category: cat,\n  query: row['Query / Note'] || '',\n  submitted_at: new Date().toISOString()\n}}];\n"
      }
    },
    {
      "id": "m3",
      "name": "Run Agent Cycle for Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        640,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/agents/cycle/run-for-contact",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ email: $json.email || undefined, phone: $json.phone || undefined }) }}"
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "allowUnauthorizedCerts": false
        }
      }
    },
    {
      "id": "m4",
      "name": "Store in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        900,
        360
      ],
      "parameters": {
        "operation": "create",
        "base": {
          "value": "appuy2VTIao6XVpIW",
          "mode": "id"
        },
        "table": {
          "value": "Team Inputs",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $('Map Category').item.json.name }}",
            "Email": "={{ $('Map Category').item.json.email }}",
            "Phone": "={{ $('Map Category').item.json.phone }}",
            "Category": "={{ $('Map Category').item.json.category }}",
            "Query": "={{ $('Map Category').item.json.query }}",
            "Submitted At": "={{ $('Map Category').item.json.submitted_at }}",
            "Agent Status": "={{ $json.status || 'no_contact' }}",
            "Agent Action": "={{ $json.chosen_action || '' }}"
          }
        }
      }
    }
  ],
  "connections": {
    "Marketing Query Form": {
      "main": [
        [
          {
            "node": "Map Category",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map Category": {
      "main": [
        [
          {
            "node": "Run Agent Cycle for Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Agent Cycle for Contact": {
      "main": [
        [
          {
            "node": "Store in Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "staticData": null,
  "tags": [],
  "pinData": null
}