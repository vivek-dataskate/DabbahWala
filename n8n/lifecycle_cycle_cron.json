      "name": "Check Push Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2580,
        360
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nlet queue_id, email, to_campaign;\ntry {\n  const prepared = $('Prepare Instantly Payload').item.json;\n  queue_id = prepared.queue_id;\n  email = prepared.email;\n  to_campaign = prepared.to_campaign;\n} catch(e) {\n  // Pairing failed (YES branch via Remove from Old Campaign)\n  // queue_id/email may be in the Instantly response if echoed, else null\n  queue_id = item.queue_id || null;\n  email = item.email || null;\n  to_campaign = null;\n}\nconst hasError = !!(item.error || (item.statusCode && item.statusCode >= 400));\nconst statusCode = item.statusCode || (hasError ? null : 200);\nconst errorMessage = hasError\n  ? (item.error?.message || item.message || JSON.stringify(item))\n  : null;\nreturn {\n  json: {\n    queue_id,\n    email,\n    to_campaign,\n    success: !hasError,\n    status_code: statusCode,\n    error_message: errorMessage,\n    response_body: JSON.stringify(item).slice(0, 2000)\n  }\n};"
      }
    },
