    {
      "parameters": {
        "jsCode": "// Map internal campaign names to Instantly campaign IDs\nconst INSTANTLY_IDS = {\n  'NURTURE_SLOW':            '76a88797-961a-47b6-af11-77e2211c4e73',\n  'PROMO_STANDARD':          'f3e2d621-9bf2-4130-bc1c-f8168fc44e1e',\n  'ACTIVE_CUSTOMER':         'c763e229-f633-468b-bfe4-7f9a4fd21036',\n  'PROMO_AGGRESSIVE':        '87d44ff1-8720-4c1d-92ff-b827970f323f',\n  'NEW_CUSTOMER_ONBOARDING': '8a5ccbfb-500d-4060-ad99-76aa0159bbf2',\n  'REACTIVATION':            '69c84455-d9b8-437f-b249-8325d23798e6'\n};\n\nconst item = $input.item.json;\n\nconst toCampaignId   = INSTANTLY_IDS[item.to_campaign];\nconst fromCampaignId = item.from_campaign ? INSTANTLY_IDS[item.from_campaign] : null;\n\nif (!toCampaignId) {\n  throw new Error(`Unknown campaign name: ${item.to_campaign}`);\n}\n\nreturn {\n  json: {\n    queue_id:                 item.queue_id,\n    email:                    item.contact_email,\n    phone:                    item.contact_phone || null,\n    to_campaign:              item.to_campaign,\n    from_campaign:            item.from_campaign || null,\n    instantly_to_campaign_id: toCampaignId,\n    instantly_from_campaign_id: fromCampaignId\n  }\n};"
      },
