    {
      "parameters": {
        "jsCode": "// Restore original payload after Remove from Old Campaign replaced $json.\n// For NO branch (direct from Has Old Campaign?): $input.item.json has queue_id.\n// For YES branch (via Remove HTTP): try paired item, fall back gracefully.\nconst item = $input.item.json;\nif (item.queue_id !== undefined && item.queue_id !== null) {\n  // NO branch — item already has original payload data\n  return { json: item };\n}\n// YES branch — Instantly DELETE response; try to recover via pairedItem\ntry {\n  return { json: $('Prepare Instantly Payload').item.json };\n} catch(e) {\n  // Pairing unavailable; pass through what we have (will be logged as error)\n  return { json: { queue_id: null, email: item.email || null, _restore_failed: true } };\n}",
        "mode": "runOnceForEachItem"
      },
      "id": "restore-payload",
      "name": "Restore Payload",
