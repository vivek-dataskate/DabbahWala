    {
      "parameters": {
        "jsCode": "// Use $('Check Push Result').item.json.queue_id - direct upstream, no branch merging.\n// This avoids the pairedItem error from the Has Old Campaign? IF branch.\ntry {\n  return { json: { queue_id: $('Check Push Result').item.json.queue_id } };\n} catch(e) {\n  // Fallback: match via email from Restore Payload .all()\n  const email = ($input.item.json.email || '').toLowerCase();\n  const allRestored = $('Restore Payload').all();\n  const match = allRestored.find(r => (r.json.email || '').toLowerCase() === email);\n  return { json: { queue_id: match ? match.json.queue_id : null } };\n}",
        "mode": "runOnceForEachItem"
      },
