      "id": "add-to-new-campaign",
      "name": "Add Lead to New Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2380,
        360
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Avoid pairedItem error caused by the Has Old Campaign? IF branch breaking the chain.\n// $input.item.json is the Instantly API response which contains 'email'.\n// Match back to the original Restore Payload item by email to recover queue_id.\nconst email = ($input.item.json.email || '').toLowerCase();\nconst allRestored = $('Restore Payload').all();\nconst match = allRestored.find(r => (r.json.email || '').toLowerCase() === email);\nconst queueId = match ? match.json.queue_id : null;\nreturn { json: { queue_id: queueId } };",
        "mode": "runOnceForEachItem"
      },
      "id": "extract-executed-queue-id",
      "name": "Extract Executed Queue ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2580,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Collect all queue_ids from successfully-processed leads into one array for a single bulk DB call.\nconst queue_ids = $input.all().map(item => item.json.queue_id).filter(id => id !== undefined && id !== null);\nreturn [{ json: { queue_ids } }];"
      },
      "id": "aggregate-executed-ids",
      "name": "Aggregate Executed IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
