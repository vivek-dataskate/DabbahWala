{
  "name": "DabbahWala — Lifecycle Cycle Runner",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DABBAHWALA_API_URL}}/api/lifecycle/run",
        "options": {
          "timeout": 60000
        }
      },
      "id": "run-lifecycle",
      "name": "Run Lifecycle Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-campaigns",
              "leftValue": "={{ $json.campaigns_queued }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-campaigns",
      "name": "Campaigns Queued?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.DABBAHWALA_API_URL}}/api/campaigns/pending",
        "options": {}
      },
      "id": "fetch-campaigns",
      "name": "Fetch Pending Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 240]
    },
    {
      "parameters": {
        "fieldToSplitOut": "=",
        "options": {}
      },
      "id": "split-campaigns",
      "name": "Split Campaign Moves",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1100, 240]
    },
    {
      "parameters": {
        "jsCode": "// Route campaign move to appropriate ESP/tool\nconst campaign = $input.item.json.to_campaign;\nconst email = $input.item.json.contact_email;\nconst phone = $input.item.json.contact_phone;\nconst queueId = $input.item.json.queue_id;\n\n// This is where you'd integrate with Mailchimp/Klaviyo/SendGrid\n// For now, log the move and mark executed\nreturn {\n  json: {\n    queue_id: queueId,\n    email: email,\n    phone: phone,\n    to_campaign: campaign,\n    action: 'move_contact_to_campaign',\n    esp_payload: {\n      list_id: campaign,\n      subscriber_email: email\n    }\n  }\n};"
      },
      "id": "route-campaign",
      "name": "Route to ESP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DABBAHWALA_API_URL}}/api/campaigns/{{ $json.queue_id }}/executed",
        "options": {}
      },
      "id": "mark-executed",
      "name": "Mark Campaign Executed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 240]
    },
    {
      "parameters": {},
      "id": "no-campaigns",
      "name": "No Campaigns — Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 400]
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Run Lifecycle Cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Lifecycle Cycle": {
      "main": [
        [
          {
            "node": "Campaigns Queued?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Campaigns Queued?": {
      "main": [
        [
          {
            "node": "Fetch Pending Campaigns",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Campaigns — Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Campaigns": {
      "main": [
        [
          {
            "node": "Split Campaign Moves",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Campaign Moves": {
      "main": [
        [
          {
            "node": "Route to ESP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route to ESP": {
      "main": [
        [
          {
            "node": "Mark Campaign Executed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "DabbahWala",
      "id": "dabbahwala"
    },
    {
      "name": "Step 3 — Lifecycle",
      "id": "step3-lifecycle"
    }
  ],
  "pinData": {}
}
