      "parameters": {
        "jsCode": "const groupDefs = [\n  {name: \"G1 Connectivity\", n: 1},\n  {name: \"G2 Schema\", n: 2},\n  {name: \"G3 Contact Setup\", n: 3},\n  {name: \"G5 Telnyx SMS\", n: 5},\n  {name: \"G7 Intelligence\", n: 7},\n  {name: \"G8 Instantly\", n: 8},\n  {name: \"G9 Airtable\", n: 9},\n  {name: \"G11 Orders\", n: 11},\n  {name: \"G12 Reports\", n: 12},\n  {name: \"G13 Chatbot\", n: 13},\n  {name: \"G14 Cleanup\", n: 14}\n];\nlet totalPassed = 0, totalFailed = 0;\nconst rows = groupDefs.map(g => {\n  let passed = 0, failed = 0, status;\n  try {\n    const r = $(g.name).first().json;\n    if (r && r.error) {\n      failed = 1; status = \"\\u274c\";\n    } else if (r && typeof r.passed === \"number\") {\n      passed = r.passed;\n      failed = r.failed || 0;\n      status = failed === 0 ? \"\\u2705\" : \"\\u274c\";\n    } else {\n      failed = 1; status = \"\\u26a0\\ufe0f\";\n    }\n  } catch(e) { failed = 1; status = \"\\u26a0\\ufe0f\"; }\n  totalPassed += passed;\n  totalFailed += failed;\n  const label = g.name.replace(/^G\\d+ /, \"\");\n  return \"<tr><td>\" + status + \" G\" + g.n + \" \" + label + \"</td><td style=\\\"text-align:center\\\">\" + passed + \"</td><td style=\\\"text-align:center\\\">\" + failed + \"</td></tr>\";\n});\nconst dateStr = new Date().toLocaleDateString(\"en-US\", {weekday:\"short\",month:\"short\",day:\"numeric\",year:\"numeric\"});\nconst overallStatus = totalFailed === 0 ? \"\\u2705 All Pass\" : \"\\u274c \" + totalFailed + \" Group(s) Failed\";\nconst html = \"<h2 style=\\\"font-family:monospace;color:#333\\\">DabbahWala Tests \\u2014 \" + dateStr + \"</h2>\"\n  + \"<p style=\\\"font-size:18px\\\"><strong>\" + overallStatus + \"</strong></p>\"\n  + \"<p>\" + totalPassed + \" passed \\u2022 \" + totalFailed + \" failed</p>\"\n  + \"<table border=\\\"1\\\" cellpadding=\\\"8\\\" cellspacing=\\\"0\\\" style=\\\"border-collapse:collapse;font-family:monospace;font-size:14px\\\">\"\n  + \"<tr style=\\\"background:#f0f0f0\\\"><th align=\\\"left\\\">Group</th><th>Passed</th><th>Failed</th></tr>\"\n  + rows.join(\"\")\n  + \"</table>\"\n  + \"<p style=\\\"color:#888;font-size:12px\\\">Sent by [System] Feature Tests \\u2014 n8n</p>\";\nreturn [{ json: {\n  subject: \"DabbahWala Tests: \" + overallStatus + \" \\u2014 \" + dateStr,\n  body_html: html\n}}];"
      },
