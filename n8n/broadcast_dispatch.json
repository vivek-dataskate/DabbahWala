{
  "name": "[Broadcast] Dispatch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 460],
      "parameters": {}
    },
    {
      "id": "get-credentials",
      "name": "Get Credentials",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "parameters": {
        "method": "GET",
        "url": "https://dabbahwala-latest.onrender.com/api/credentials",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "dw-admin-secret",
          "name": "DW Admin Secret"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://dabbahwala-latest.onrender.com/api/broadcasts/pending-recipients",
        "options": {}
      },
      "id": "fetch-pending",
      "name": "Fetch Pending Recipients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ Array.isArray($json) ? $json.length : 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-pending",
      "name": "Has Pending Recipients?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "const recipients = $input.first().json;\nif (!Array.isArray(recipients) || recipients.length === 0) return [];\nreturn recipients.map(item => ({ json: item }));"
      },
      "id": "split-recipients",
      "name": "Split Recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 220]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "sms",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sms"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "email",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            }
          ]
        },
        "options": {}
      },
      "id": "route-by-channel",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1320, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telnyx.com/v2/messages",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"+18444322224\",\n  \"to\": \"{{ $json.phone }}\",\n  \"text\": \"{{ $json.sms_message }}\",\n  \"messaging_profile_id\": \"400191f9-0057-41f5-9f10-375fb3fe1a70\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Credentials').first().json.TELNYX_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-sms-telnyx",
      "name": "Send SMS via Telnyx",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const telnyx = $input.item.json;\nconst recipient = $('Split Recipients').item.json;\nconst success = !!(telnyx.data && telnyx.data.id);\nreturn { json: { success, recipient_id: recipient.recipient_id, telnyx_msg_id: telnyx.data?.id || '', error: telnyx.errors?.[0]?.detail || '' } };"
      },
      "id": "check-sms-result",
      "name": "Check SMS Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/broadcasts/recipients/{{ $json.recipient_id }}/{{ $json.success ? 'sent' : 'failed' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.success ? '{}' : JSON.stringify({ error_message: $json.error || 'Telnyx send failed' }) }}",
        "options": {}
      },
      "id": "mark-sms-result",
      "name": "Mark SMS Sent/Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/internal/send-email",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.email, subject: $json.email_subject || 'Message from DabbahWala', body_html: $json.email_body || $json.sms_message || '' }) }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 360],
      "credentials": {
        "httpHeaderAuth": {
          "id": "dw-admin-secret",
          "name": "DW Admin Secret"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const result = $input.item.json;\nconst recipient = $('Split Recipients').item.json;\nconst success = result.status === 'ok' || (result.message && !result.detail);\nreturn { json: { success, recipient_id: recipient.recipient_id, error: result.detail || result.error || '' } };"
      },
      "id": "check-email-result",
      "name": "Check Email Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/broadcasts/recipients/{{ $json.recipient_id }}/{{ $json.success ? 'sent' : 'failed' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.success ? '{}' : JSON.stringify({ error_message: $json.error || 'Email send failed' }) }}",
        "options": {}
      },
      "id": "mark-email-result",
      "name": "Mark Email Sent/Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 360],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "no-pending",
      "name": "No Pending \u2014 Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, 400]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{"node": "Get Credentials", "type": "main", "index": 0}]]
    },
    "Manual Trigger": {
      "main": [[{"node": "Get Credentials", "type": "main", "index": 0}]]
    },
    "Get Credentials": {
      "main": [[{"node": "Fetch Pending Recipients", "type": "main", "index": 0}]]
    },
    "Fetch Pending Recipients": {
      "main": [[{"node": "Has Pending Recipients?", "type": "main", "index": 0}]]
    },
    "Has Pending Recipients?": {
      "main": [
        [{"node": "Split Recipients", "type": "main", "index": 0}],
        [{"node": "No Pending \u2014 Skip", "type": "main", "index": 0}]
      ]
    },
    "Split Recipients": {
      "main": [[{"node": "Route by Channel", "type": "main", "index": 0}]]
    },
    "Route by Channel": {
      "sms": [[{"node": "Send SMS via Telnyx", "type": "main", "index": 0}]],
      "email": [[{"node": "Send Email", "type": "main", "index": 0}]]
    },
    "Send SMS via Telnyx": {
      "main": [[{"node": "Check SMS Result", "type": "main", "index": 0}]]
    },
    "Check SMS Result": {
      "main": [[{"node": "Mark SMS Sent/Failed", "type": "main", "index": 0}]]
    },
    "Send Email": {
      "main": [[{"node": "Check Email Result", "type": "main", "index": 0}]]
    },
    "Check Email Result": {
      "main": [[{"node": "Mark Email Sent/Failed", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
