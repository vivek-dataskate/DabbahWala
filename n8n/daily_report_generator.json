{
  "name": "DabbahWala — Daily Report Generator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily at 11 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "// Get today's date in YYYY-MM-DD\nconst today = new Date().toISOString().split('T')[0];\nreturn [{ json: { report_date: today } }];"
      },
      "id": "get-date",
      "name": "Get Today's Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DABBAHWALA_API_URL}}/api/reports/daily/{{ $json.report_date }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "generate-report",
      "name": "Generate Daily Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-orders",
              "leftValue": "={{ $json.net_new_orders }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "report-generated",
      "name": "Report Generated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format Slack/webhook notification\nconst report = $input.first().json;\nconst activity = report.activity || {};\nconst pipeline = report.pipeline || {};\n\nconst lines = [\n  `*DabbahWala Daily Report — ${report.report_date}*`,\n  '',\n  '*Activity:*',\n  `  Orders: ${activity.order_placed || 0}`,\n  `  Email Opens: ${activity.email_open || 0}`,\n  `  Email Clicks: ${activity.email_click || 0}`,\n  `  SMS Sent: ${activity.sms_sent || 0}`,\n  `  SMS Clicks: ${activity.sms_click || 0}`,\n  '',\n  `*Net New Attributed Orders:* ${report.net_new_orders || 0}`,\n  '',\n  '*Pipeline:*',\n  ...Object.entries(pipeline).map(([seg, count]) => `  ${seg}: ${count}`),\n  '',\n  `*Transitions:* ${(report.transitions || []).length} segment moves`\n];\n\nreturn [{ json: {\n  text: lines.join('\\n'),\n  report_date: report.report_date,\n  net_new_orders: report.net_new_orders\n}}];"
      },
      "id": "format-notification",
      "name": "Format Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.text }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-slack",
      "name": "Notify Slack (Optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 240],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "report-failed",
      "name": "Report Failed — Alert",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, 400]
    }
  ],
  "connections": {
    "Daily at 11 PM": {
      "main": [
        [
          {
            "node": "Get Today's Date",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Today's Date": {
      "main": [
        [
          {
            "node": "Generate Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Daily Report": {
      "main": [
        [
          {
            "node": "Report Generated?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report Generated?": {
      "main": [
        [
          {
            "node": "Format Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report Failed — Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Notification": {
      "main": [
        [
          {
            "node": "Notify Slack (Optional)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "DabbahWala",
      "id": "dabbahwala"
    },
    {
      "name": "Step 3 — Reports",
      "id": "step3-reports"
    }
  ],
  "pinData": {}
}
