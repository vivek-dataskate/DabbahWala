{
  "name": "[Email Campaigns] Campaign Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.instantly.ai/api/v2/campaigns",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Credentials').first().json.INSTANTLY_BEARER }}"
            }
          ]
        }
      },
      "id": "fetch-instantly-campaigns",
      "name": "Fetch All Instantly Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filter campaigns whose tags include 'dabbahwala' (case-insensitive)\nconst data = $input.first().json;\nconst list = Array.isArray(data) ? data\n  : (data.items || data.campaigns || data.data || []);\n\nconst filtered = list.filter(c => {\n  const tags = c.tags || [];\n  return tags.some(t => {\n    const name = typeof t === 'string' ? t : (t.name || t.label || '');\n    return name.trim().toLowerCase() === 'dabbahwala';\n  });\n});\n\nif (filtered.length === 0) {\n  return [{ json: { campaigns: [] } }];\n}\n\n// Normalise into the shape Render expects\nconst campaigns = filtered.map(c => {\n  const rawTags = c.tags || [];\n  const tagNames = rawTags.map(t => typeof t === 'string' ? t : (t.name || t.label || ''));\n  return {\n    campaign_id: String(c.id || c.campaign_id || ''),\n    name:        c.name || c.campaign_name || '',\n    tags:        tagNames,\n    status:      String(c.status || c.campaign_status || '')\n  };\n});\n\nreturn [{ json: { campaigns } }];"
      },
      "id": "filter-dabbahwala",
      "name": "Filter: tag = dabbahwala",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/webhooks/sync-campaigns",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "upsert-to-render",
      "name": "Upsert Campaigns in Render DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {},
      "id": "done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "id": "510f61db-c265-4591-af1d-933412715074",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        460
      ],
      "parameters": {}
    },
    {
      "id": "get-credentials",
      "name": "Get Credentials",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://dabbahwala-latest.onrender.com/api/credentials",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "dw-admin-secret",
          "name": "DW Admin Secret"
        }
      }
    }
  ],
  "connections": {
