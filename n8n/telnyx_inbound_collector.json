{
  "name": "[Telnyx — Evidence] Inbound SMS Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "id": "a935bda3-5c6a-42fb-9ecd-b5154bfe68e4",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        460
      ],
      "parameters": {}
    },
    {
      "parameters": {
        "jsCode": "// 35-minute window so consecutive 30-min runs overlap and miss nothing\nconst now = new Date();\nconst from = new Date(now.getTime() - 35 * 60 * 1000);\nreturn [{ json: {\n  window_from: from.toISOString(),\n  window_to:   now.toISOString()\n}}];"
      },
      "id": "build-time-window",
      "name": "Build Time Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.telnyx.com/v2/reports/messaging/message_detail_records",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filter[direction]",
              "value": "INBOUND"
            },
            {
              "name": "filter[created_at][gte]",
              "value": "={{ $json.window_from }}"
            },
            {
              "name": "page[size]",
              "value": "250"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "fetch-inbound-sms",
      "name": "Fetch Inbound SMS (MDR)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "XnntvX8AXpdR97oQ",
          "name": "Telnyx API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.telnyx.com/v2/recordings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filter[created_at][gte]",
              "value": "={{ $('Build Time Window').item.json.window_from }}"
            },
            {
              "name": "page[size]",
              "value": "50"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "fetch-call-recordings",
      "name": "Fetch Call Recordings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        440
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "XnntvX8AXpdR97oQ",
          "name": "Telnyx API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// MDR response: data[].from_number, data[].to_number, data[].message_body, data[].id\nconst messages = $input.item.json.data || [];\n\nconst ORDER_KEYWORDS    = ['order', 'ordered', 'i want', 'can i order', 'how do i order', 'place an order'];\nconst DELIVERY_KEYWORDS = ['delivered', 'delivery', 'dispatched', 'out for delivery', 'shipped', 'tracking', 'package', 'collect', 'picked up', 'received'];\nconst REORDER_KEYWORDS  = ['again', 'reorder', 'same as last', 'another', 'refill', 'repeat'];\nconst PRICE_KEYWORDS    = ['price', 'cost', 'how much', 'discount', 'offer', 'deal', 'promo'];\n\nreturn messages.map(msg => {\n  const body = (msg.message_body || msg.text || '').toLowerCase();\n  const from = msg.from_number || (msg.from?.phone_number) || '';\n  const to   = msg.to_number   || (msg.to?.[0]?.phone_number) || '';\n\n  const isOrderSignal    = ORDER_KEYWORDS.some(kw => body.includes(kw));\n  const isDeliverySignal = DELIVERY_KEYWORDS.some(kw => body.includes(kw));\n  const isReorderSignal  = REORDER_KEYWORDS.some(kw => body.includes(kw));\n  const isPriceSignal    = PRICE_KEYWORDS.some(kw => body.includes(kw));\n\n  let event_type = 'sms_received';\n  if (isOrderSignal || isReorderSignal) event_type = 'order_intent_sms';\n  else if (isDeliverySignal)            event_type = 'delivery_inquiry_sms';\n  else if (isPriceSignal)               event_type = 'price_inquiry_sms';\n\n  return {\n    json: {\n      telnyx_msg_id: msg.id,\n      from_number: from,\n      to_number: to,\n      body: msg.message_body || msg.text || '',\n      direction: 'inbound',\n      status: msg.status || 'received',\n      is_order_signal: isOrderSignal || isReorderSignal,\n      event_type,\n      metadata: {\n        received_at: msg.sent_at || msg.received_at,\n        signals: { isOrderSignal, isDeliverySignal, isReorderSignal, isPriceSignal }\n      }\n    }\n  };\n}).filter(m => m.json.from_number);"
      },
      "id": "classify-sms",
      "name": "Classify SMS + Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract key info from call recordings\nconst recordings = $input.item.json.data || [];\n\nconst REORDER_KEYWORDS = ['order again', 'same as last', 'reorder', 'another order', 'repeat', 'refill'];\nconst COMPLAINT_WORDS  = ['late', 'cold', 'wrong', 'missing', 'refund', 'cancel', 'unhappy', 'disappointed'];\n\nreturn recordings.map(rec => {\n  const transcript = (rec.transcription?.transcript || '').toLowerCase();\n  const from = rec.from || '';\n  const to   = rec.to || '';\n\n  const hasReorderSignal  = REORDER_KEYWORDS.some(kw => transcript.includes(kw));\n  const hasComplaintSignal = COMPLAINT_WORDS.some(kw => transcript.includes(kw));\n\n  let event_type = 'call_completed';\n  if (hasReorderSignal)   event_type = 'reorder_intent_call';\n  else if (hasComplaintSignal) event_type = 'complaint_call';\n\n  return {\n    json: {\n      recording_id: rec.id,\n      from_number: from,\n      to_number: to,\n      direction: rec.direction || 'inbound',\n      recording_url: rec.download_url || rec.url || null,\n      transcript: rec.transcription?.transcript || null,\n      summary: null,\n      duration_sec: rec.duration_secs ? Math.round(rec.duration_secs) : null,\n      started_at: rec.start_time || null,\n      ended_at: rec.end_time || null,\n      event_type,\n      has_order_signal: hasReorderSignal,\n      metadata: { recording_id: rec.id, signals: { hasReorderSignal, hasComplaintSignal } }\n    }\n  };\n}).filter(r => r.json.from_number);"
      },
      "id": "process-recordings",
      "name": "Classify Calls + Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-sms",
              "leftValue": "={{ $json.from_number }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-sms-data",
      "name": "Has SMS?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        180
