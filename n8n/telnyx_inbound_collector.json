        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_phone\": \"{{ $json.from_number }}\",\n  \"direction\": \"{{ $json.direction }}\",\n  \"from_number\": \"{{ $json.from_number }}\",\n  \"to_number\": \"{{ $json.to_number }}\",\n  \"body\": \"{{ $json.body.replace(/\"/g, '\\\\\"') }}\",\n  \"telnyx_msg_id\": \"{{ $json.telnyx_msg_id }}\",\n  \"status\": \"{{ $json.status }}\",\n  \"is_delivery_staff\": false,\n  \"metadata\": {{ JSON.stringify($json.metadata) }}\n}",
        "options": {
          "timeout": 15000
        }
      },
