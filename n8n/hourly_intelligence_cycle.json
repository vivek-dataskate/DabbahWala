{
  "name": "[Agent Intelligence] Hourly Intelligence Cycle",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 1}]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.instantly.ai/api/v1/analytics/campaign/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "limit", "value": "100"},
            {"name": "since", "value": "={{ $now.minus(2, 'hours').toISO() }}"}
          ]
        },
        "options": {}
      },
      "id": "poll-instantly",
      "name": "Poll Instantly Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/intelligence/ingest-instantly-events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ events: $json.events || [] }) }}",
        "options": {}
      },
      "id": "ingest-events",
      "name": "Ingest Events to DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/intelligence/run-cycle",
        "options": {
          "timeout": 120000
        }
      },
      "id": "run-cycle",
      "name": "Run Intelligence Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://dabbahwala-latest.onrender.com/api/intelligence/pending-actions",
        "options": {}
      },
      "id": "get-actions",
      "name": "Get Pending Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-pending",
              "leftValue": "={{ $json.summary?.total_pending || 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-actions",
      "name": "Has Pending Actions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "jsCode": "// Split pending actions response into individual items tagged by action type\nconst data = $('Get Pending Actions').first().json;\nconst items = [];\n\n// SMS opportunities\nfor (const sms of (data.sms_to_send || [])) {\n  items.push({ json: { ...sms, _action_type: 'send_sms' } });\n}\n\n// Sales call opportunities\nfor (const call of (data.sales_calls || [])) {\n  items.push({ json: { ...call, _action_type: 'field_sales_call' } });\n}\n\n// Email opportunities\nfor (const email of (data.emails_to_send || [])) {\n  items.push({ json: { ...email, _action_type: 'send_email' } });\n}\n\nreturn items.length > 0 ? items : [{ json: { _action_type: 'none' } }];"
      },
      "id": "split-actions",
      "name": "Split Into Individual Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 240]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json._action_type }}",
                    "rightValue": "send_sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "SMS"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json._action_type }}",
                    "rightValue": "field_sales_call",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Sales Call"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "route-by-type",
      "name": "Route by Action Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1620, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telnyx.com/v2/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"+18444322224\",\n  \"to\": \"{{ $json.phone }}\",\n  \"text\": \"{{ $json.template_body || $json.suggested_message || 'Check out today\\'s fresh menu at dabbahwala.com!' }}\"\n}",
        "options": {}
      },
      "id": "send-sms",
      "name": "Send SMS via Telnyx",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1860, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "XnntvX8AXpdR97oQ",
          "name": "Telnyx API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/opportunities/{{ $('Route by Action Type').item.json.id }}/dispatched",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"airtable_record_id\": \"sms-{{ $now.toMillis() }}\"\n}",
        "options": {}
      },
      "id": "mark-sms-dispatched",
      "name": "Mark SMS Dispatched",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2080, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.airtable.com/v0/appuy2VTIao6XVpIW/Field%20Sales%20Tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"Customer Name\": \"{{ $json.first_name || '' }} {{ $json.last_name || '' }}\",\n    \"Phone\": \"{{ $json.phone || '' }}\",\n    \"Priority\": \"{{ $json.priority || 'warm' }}\",\n    \"Reason\": \"{{ $json.reason || '' }}\",\n    \"Suggested Action\": \"{{ $json.suggested_message || '' }}\",\n    \"Status\": \"New\",\n    \"Postgres Opportunity ID\": {{ $json.id || 0 }}\n  }\n}",
        "options": {}
      },
      "id": "create-airtable-task",
      "name": "Create Airtable Sales Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1860, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "hJpO8jdlT4Rmkjtx",
          "name": "Airtable API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://dabbahwala-latest.onrender.com/api/opportunities/{{ $('Route by Action Type').item.json.id }}/dispatched",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"airtable_record_id\": \"{{ $json.id || 'n8n-' + $now.toMillis() }}\"\n}",
        "options": {}
      },
      "id": "mark-call-dispatched",
      "name": "Mark Call Dispatched",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2080, 300]
    },
    {
      "parameters": {},
      "id": "no-actions",
      "name": "No Pending — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1400, 450]
    },
    {
      "parameters": {},
      "id": "skip-other",
      "name": "Other Actions — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1860, 450]
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {"node": "Poll Instantly Events", "type": "main", "index": 0}
        ]
      ]
    },
    "Poll Instantly Events": {
      "main": [
        [
          {"node": "Ingest Events to DB", "type": "main", "index": 0}
        ]
      ]
    },
    "Ingest Events to DB": {
      "main": [
        [
          {"node": "Run Intelligence Cycle", "type": "main", "index": 0}
        ]
      ]
    },
    "Run Intelligence Cycle": {
      "main": [
        [
          {"node": "Get Pending Actions", "type": "main", "index": 0}
        ]
      ]
    },
    "Get Pending Actions": {
      "main": [
        [
          {"node": "Has Pending Actions?", "type": "main", "index": 0}
        ]
      ]
    },
    "Has Pending Actions?": {
      "main": [
        [
          {"node": "Split Into Individual Actions", "type": "main", "index": 0}
        ],
        [
          {"node": "No Pending — Skip", "type": "main", "index": 0}
        ]
      ]
    },
    "Split Into Individual Actions": {
      "main": [
        [
          {"node": "Route by Action Type", "type": "main", "index": 0}
        ]
      ]
    },
    "Route by Action Type": {
      "main": [
        [
          {"node": "Send SMS via Telnyx", "type": "main", "index": 0}
        ],
        [
          {"node": "Create Airtable Sales Task", "type": "main", "index": 0}
        ],
        [
          {"node": "Other Actions — Skip", "type": "main", "index": 0}
        ]
      ]
    },
    "Send SMS via Telnyx": {
      "main": [
        [
          {"node": "Mark SMS Dispatched", "type": "main", "index": 0}
        ]
      ]
    },
    "Create Airtable Sales Task": {
      "main": [
        [
          {"node": "Mark Call Dispatched", "type": "main", "index": 0}
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {"name": "DabbahWala", "id": "dabbahwala"},
    {"name": "Agent Intelligence", "id": "agent-intelligence"}
  ],
  "pinData": {}
}
