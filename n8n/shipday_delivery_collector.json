{
  "name": "[Shipday — Evidence] Delivery Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build a 35-minute lookback window (overlaps 30-min schedule to catch everything)\nconst now = new Date();\nconst from = new Date(now.getTime() - 35 * 60 * 1000);\nreturn [{ json: {\n  window_from: from.toISOString().replace('T', ' ').slice(0, 19),\n  window_from_iso: from.toISOString()\n}}];"
      },
      "id": "build-time-window",
      "name": "Build Time Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.shipday.com/orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $json.window_from }}"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "fetch-shipday-orders",
      "name": "Fetch Shipday Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "shipday-api-key",
          "name": "Shipday API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Normalise Shipday order response — handles both array and { orders: [...] } shapes\nconst raw = $input.item.json;\nconst orders = Array.isArray(raw) ? raw : (raw.orders || raw.data || []);\n\n// Map Shipday statuses → our delivery event types + status labels\nconst STATUS_MAP = {\n  ACCEPTED:   { event: 'order_accepted',    status: 'accepted' },\n  ASSIGNED:   { event: 'driver_assigned',   status: 'driver_assigned' },\n  PICKED_UP:  { event: 'out_for_delivery',  status: 'out_for_delivery' },\n  ARRIVED:    { event: 'delivery_arrived',  status: 'arrived' },\n  COMPLETED:  { event: 'delivered',         status: 'delivered' },\n  FAILED:     { event: 'delivery_failed',   status: 'failed' },\n  RETURNED:   { event: 'delivery_returned', status: 'returned' },\n  UNASSIGNED: { event: 'delivery_pending',  status: 'pending' },\n};\n\nreturn orders\n  .filter(o => o.customer?.email || o.customer?.phone)\n  .map(o => {\n    const shipday_status = (o.orderStatus || o.status || 'UNKNOWN').toUpperCase();\n    const mapped = STATUS_MAP[shipday_status] || { event: 'delivery_update', status: shipday_status.toLowerCase() };\n    return {\n      json: {\n        order_id:        o.orderId || o.id || '',\n        order_number:    o.orderNumber || o.referenceId || '',\n        contact_email:   o.customer?.email || '',\n        contact_phone:   o.customer?.phone || '',\n        customer_name:   o.customer?.name || '',\n        shipday_status,\n        event_type:      mapped.event,\n        delivery_status: mapped.status,\n        driver_name:     o.assignedCarrier?.name || '',\n        driver_phone:    o.assignedCarrier?.phone || '',\n        est_delivery:    o.estimatedDeliveryTime || null,\n        actual_delivery: o.actualDeliveryTime || null,\n        address:         o.customer?.address || o.deliveryAddress?.address || '',\n        metadata: {\n          shipday_order_id:  o.orderId,\n          order_number:      o.orderNumber,\n          driver:            o.assignedCarrier?.name || null,\n          estimated_delivery: o.estimatedDeliveryTime || null,\n          actual_delivery:    o.actualDeliveryTime || null\n        }\n      }\n    };\n  });"
      },
      "id": "normalise-orders",
      "name": "Normalise Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-contact",
              "leftValue": "={{ $json.contact_email || $json.contact_phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-contact",
      "name": "Has Contact?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/delivery/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_email\": \"{{ $json.contact_email || '' }}\",\n  \"contact_phone\": \"{{ $json.contact_phone || '' }}\",\n  \"order_ref\": \"{{ $json.order_number }}\",\n  \"status\": \"{{ $json.delivery_status }}\",\n  \"updated_by\": \"shipday\",\n  \"notes\": \"Shipday status: {{ $json.shipday_status }}{{ $json.driver_name ? '. Driver: ' + $json.driver_name : '' }}\",\n  \"location\": \"{{ $json.address }}\",\n  \"metadata\": {{ JSON.stringify($json.metadata) }}\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "store-delivery-status",
      "name": "Store Delivery Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/events/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_email\": \"{{ $('Normalise Orders').item.json.contact_email || '' }}\",\n  \"contact_phone\": \"{{ $('Normalise Orders').item.json.contact_phone || '' }}\",\n  \"event_type\": \"{{ $('Normalise Orders').item.json.event_type }}\",\n  \"metadata\": {\n    \"source\": \"shipday\",\n    \"order_number\": \"{{ $('Normalise Orders').item.json.order_number }}\",\n    \"shipday_status\": \"{{ $('Normalise Orders').item.json.shipday_status }}\",\n    \"driver\": \"{{ $('Normalise Orders').item.json.driver_name }}\",\n    \"address\": \"{{ $('Normalise Orders').item.json.address }}\"\n  }\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "ingest-delivery-event",
      "name": "Ingest Delivery Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        360
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/agents/cycle/run-for-contact",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $('Normalise Orders').item.json.contact_email }}\",\n  \"phone\": \"{{ $('Normalise Orders').item.json.contact_phone }}\"\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "evaluate-opportunity",
      "name": "Evaluate Opportunity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        280
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-completed",
              "leftValue": "={{ $('Normalise Orders').item.json.shipday_status }}",
              "rightValue": "COMPLETED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-delivered",
      "name": "Order Delivered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1780,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/events/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_email\": \"{{ $('Normalise Orders').item.json.contact_email }}\",\n  \"event_type\": \"order_placed\",\n  \"metadata\": {\n    \"source\": \"shipday_completed\",\n    \"order_number\": \"{{ $('Normalise Orders').item.json.order_number }}\",\n    \"completed_at\": \"{{ $('Normalise Orders').item.json.actual_delivery }}\"\n  }\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "ingest-order-placed",
      "name": "Ingest order_placed Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "skip-no-contact",
      "name": "Skip — No Contact Info",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        480
      ]
    },
    {
      "parameters": {},
      "id": "not-completed",
      "name": "Status Update Logged",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2000,
        380
      ]
    }
  ],
