{
  "name": "[Website — Evidence] Weekly Menu Scrape",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Monday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dabbahwala-latest.onrender.com/api/menu-scrape/run",
        "options": {
          "timeout": 180000
        }
      },
      "id": "trigger-scrape",
      "name": "Trigger Menu Scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "scrape-ok",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-status",
      "name": "Scrape Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://dabbahwala-latest.onrender.com/api/menu-scrape/current",
        "options": {}
      },
      "id": "fetch-current-menu",
      "name": "Fetch Current Menu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-week-start",
              "name": "Week Start",
              "value": "={{ $json.week_start }}",
              "type": "string"
            },
            {
              "id": "field-item-count",
              "name": "Item Count",
              "value": "={{ $json.count }}",
              "type": "number"
            },
            {
              "id": "field-items-json",
              "name": "Items JSON",
              "value": "={{ JSON.stringify($json.items) }}",
              "type": "string"
            },
            {
              "id": "field-scraped-at",
              "name": "Scraped At",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-for-airtable",
      "name": "Format for Airtable",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "operation": "upsert",
        "base": {
          "__rl": true,
          "value": "appuy2VTIao6XVpIW",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Weekly Menu",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["Week Start"],
          "options": {}
        },
        "options": {}
      },
      "id": "log-to-airtable",
      "name": "Log to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1320, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "hJpO8jdlT4Rmkjtx",
          "name": "Airtable API Key"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "core@dabbahwala.com",
        "toEmail": "core@dabbahwala.com",
        "subject": "=Weekly Menu Scraped — {{ $('Trigger Menu Scrape').item.json.items_scraped }} items for {{ $('Trigger Menu Scrape').item.json.week_start }}",
        "emailType": "text",
        "message": "=Menu scrape completed successfully.\n\nWeek: {{ $('Trigger Menu Scrape').item.json.week_start }}\nItems scraped: {{ $('Trigger Menu Scrape').item.json.items_scraped }}\n\nView in dashboard: https://dabbahwala-latest.onrender.com/api/menu-scrape/current",
        "options": {}
      },
      "id": "notify-success",
      "name": "Email Success Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1100, 380],
      "credentials": {
        "smtp": {
          "id": "Sk6XzPNPnJTXHEbr",
          "name": "Gmail-SMTP"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "core@dabbahwala.com",
        "toEmail": "core@dabbahwala.com",
        "subject": "ALERT: Weekly Menu Scrape Failed",
        "emailType": "text",
        "message": "=The weekly menu scrape failed or returned empty results.\n\nStatus: {{ $('Trigger Menu Scrape').item.json.status }}\nItems: {{ $('Trigger Menu Scrape').item.json.items_scraped ?? 0 }}\n\nCheck Render logs: https://dashboard.render.com",
        "options": {}
      },
      "id": "notify-failure",
      "name": "Email Failure Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 400],
      "credentials": {
        "smtp": {
          "id": "Sk6XzPNPnJTXHEbr",
          "name": "Gmail-SMTP"
        }
      }
    }
  ],
  "connections": {
    "Every Monday 8am": {
      "main": [[{"node": "Trigger Menu Scrape", "type": "main", "index": 0}]]
    },
    "Trigger Menu Scrape": {
      "main": [[{"node": "Scrape Succeeded?", "type": "main", "index": 0}]]
    },
    "Scrape Succeeded?": {
      "main": [
        [{"node": "Fetch Current Menu", "type": "main", "index": 0}],
        [{"node": "Email Failure Alert", "type": "main", "index": 0}]
      ]
    },
    "Fetch Current Menu": {
      "main": [
        [
          {"node": "Format for Airtable", "type": "main", "index": 0},
          {"node": "Email Success Notification", "type": "main", "index": 0}
        ]
      ]
    },
    "Format for Airtable": {
      "main": [
        [{"node": "Log to Airtable", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
